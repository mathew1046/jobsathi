# Security-hardened Dockerfile for production
FROM python:3.12-slim as base

# Security: Run as non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Security: Install only necessary packages and clean up
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Security: Copy only requirements first (layer caching)
COPY --chown=appuser:appuser backend/app/requirements.txt .

# Security: Install packages as root, then switch to user
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Security: Copy application code
COPY --chown=appuser:appuser backend/app/ .

# Security: Create database directory with correct permissions
RUN mkdir -p /app/database && chown -R appuser:appuser /app/database

# Security: Switch to non-root user
USER appuser

# Security: Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Security: Expose only necessary port
EXPOSE 8000

# Security: Run with limited privileges
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
