FROM python:3.10-slim

# Install system dependencies
# ffmpeg is required for audio processing
# libsndfile1 is required for torchaudio
RUN apt-get update && apt-get install -y \
    build-essential \
    libsndfile1 \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set up a new user named "user" with user ID 1000
# Hugging Face Spaces requires the container to run as a non-root user (UID 1000)
RUN useradd -m -u 1000 user

# Switch to the "user" user
USER user

# Set environment variables
ENV HOME=/home/user \
	PATH=/home/user/.local/bin:$PATH

# Set working directory to the user's home directory
WORKDIR $HOME/app

# Copy requirements first to leverage Docker cache
COPY --chown=user requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir torchcodec

# Copy the application code
COPY --chown=user . .

# Create database directory and ensure permissions
# This is where temporary files and resumes will be stored
RUN mkdir -p database

# Expose port 7860 (Standard for Hugging Face Spaces)
EXPOSE 7860

# Command to run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
