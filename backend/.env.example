# JobSathi Backend Environment Variables

# Required for catalog search and durable interview sessions. Apply migrations first.
DATABASE_URL=postgresql://jobsathi:jobsathi@127.0.0.1:5432/jobsathi
DATABASE_POOL_SIZE=4
# Alternatively leave DATABASE_URL empty and use separate libpq credentials.
# Passwords here are literal values (no URI percent-encoding required).
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=jobsathi
# PGUSER=jobsathi
# PGPASSWORD=strong/password
# PGSSLMODE=prefer
# Optional shared durable storage directory for generated JSON exports and PDFs.
# RESUME_STORAGE_DIR=/var/lib/jobsathi/resumes

# Gemini API Configuration (only required for interview extraction/resume generation)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Job import API Keys (optional; search reads the stored catalog, never these APIs)
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Jooble: https://jooble.org/api/about
JOOBLE_KEY=your_jooble_api_key

# SerpAPI: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Model Configuration
ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
DEVICE=auto
